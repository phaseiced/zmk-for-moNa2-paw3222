#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 3>;
        };

        combo2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <6 7>;
        };

        combo3 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <12 13>;
        };

        combo4 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 17>;
        };

        combo5 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <23 24>;
        };

        combo6 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <29 30>;
        };

        combo7 {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <4 5>;
        };

        combo8 {
            bindings = <&kp PIPE>;
            key-positions = <14 15>;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <300>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp B           &kp L           &kp D         &kp C             &kp V                                      &kp J            &kp Y              &kp O        &kp U            &kp SEMICOLON
&hm LEFT_GUI N  &hm LEFT_ALT R  &hm LCTRL T   &hm LEFT_SHIFT S  &kp G                       &kp PAGE_UP    &kp P            &hm RIGHT_SHIFT H  &hm RCTRL A  &hm RIGHT_ALT E  &hm RIGHT_WIN I
&kp X           &kp Q           &kp M         &kp W             &kp Z        &mo 4          &kp PAGE_DOWN  &kp K            &kp F              &kp COMMA    &kp PERIOD       &kp SLASH
&kp LCTRL       &kp LALT        &kp LEFT_GUI  &lt 2 ESC         &lt 1 SPACE  &lt 5 TAB      &lt 5 ENTER    &lt 2 BACKSPACE                                                   &lt 3 DELETE
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "BASE";
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                             &trans  &kp N7        &kp N8        &kp N9        &kp SLASH
&trans  &trans  &trans  &trans  &trans                              &kp PG_UP      &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK
&trans  &trans  &trans  &trans  &trans  &kp C_BACKLIGHT_TOGGLE      &kp PAGE_DOWN  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans                      &kp ENTER      &kp N0                                            &kp PLUS
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "NUM";
        };

        NAV {
            bindings = <
&kp ESC                 &trans              &kp K_BACK     &kp K_FORWARD      &kp F5                                  &kp LC(HOME)  &kp HOME        &kp UP_ARROW  &kp END    &kp LC(END)
&kp LG(LC(LEFT_ARROW))  &kp LG(LEFT_ARROW)  &kp LG(RIGHT)  &kp LG(LC(RIGHT))  &kp LG(TAB)              &kp PG_UP      &trans        &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &kp DELETE
&trans                  &trans              &trans         &trans             &trans       &trans      &kp PAGE_DOWN  &trans        &trans          &trans        &trans     &trans
&trans                  &trans              &trans         &trans             &trans       &trans      &trans         &trans                                                 &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "NAV";
        };

        MOUSE {
            bindings = <
&kp C_AC_ZOOM_IN   &trans    &trans    &trans     &trans                             &trans  &trans    &trans    &trans    &kp C_AC_ZOOM_IN
&kp C_AC_ZOOM_OUT  &mkp MB1  &mkp MB3  &mkp MB2   &trans              &kp PG_UP      &trans  &mkp MB1  &mkp MB3  &mkp MB2  &kp C_AC_ZOOM_OUT
&trans             &trans    &trans    &trans     &trans  &trans      &kp PAGE_DOWN  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans             &trans    &trans    &kp LCTRL  &trans  &trans      &trans         &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "MOUSE";
        };

        BT {
            bindings = <
&kp F1  &trans  &trans  &trans  &trans                              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans              &bt BT_CLR      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            display-name = "BT";
        };

        SYM {
            bindings = <
&kp PERIOD  &kp TILDE  &kp PIPE  &kp AMPERSAND  &kp ASTERISK                      &kp SLASH  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp CARET  &kp PERCENT
&trans      &trans     &trans    &trans         &trans                    &trans  &trans     &trans          &trans           &trans     &trans
&trans      &trans     &trans    &trans         &trans        &trans      &trans  &trans     &trans          &trans           &trans     &trans
&trans      &kp F2     &kp F4    &trans         &trans        &trans      &trans  &trans                                                 &trans
            >;
        };
    };
};
